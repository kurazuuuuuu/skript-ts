{
  "description": "Write Minecraft Skript scripts in typed TypeScript and transpile them to .sk files.",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mineflayer": "^4.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.5.1",
    "vite-plus": "^1.5.1",
    "vitest": "^5.1.0"
  },
  "name": "skript-ts",
  "packageManager": "pnpm@12.15.0",
  "overrides": {
    "vite": "$vite"
  },
  "private": true,
  "scripts": {
    "check": "vp check",
    "cli": "tsx src/cli.ts",
    "emit-examples": "tsx examples/print-all.ts",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "2026.11.11",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "bin": {
    "skript-ts": "bin/skript-ts.mjs"
  }
}
