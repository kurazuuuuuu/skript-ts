{
  "name": "skript-ts",
  "version": "2026.11.14",
  "description": "Write Minecraft Skript scripts in typed TypeScript and transpile them to .sk files.",
  "bin": {
    "skript-ts": "bin/skript-ts.mjs"
  },
  "files": [
    "bin",
    "dist",
    "engine",
    "!engine/build",
    "!engine/libs",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "vp check",
    "cli": "tsx src/cli.ts",
    "format": "vp fmt",
    "lint": "vp lint",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mineflayer": "^4.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.5.1",
    "vite-plus": "^1.5.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
