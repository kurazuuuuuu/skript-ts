on join:
    set {mismatch} to "abc"

function greet(name: text) :: text:
    return "Hello, %{_name}%!"

function greetTimes(name: text, times: number = 1) :: text:
    set {_out} to ""
    set {_i} to 0
    while {_i} is less than {_times}:
        set {_out} to "%{_out}%%{_name}%"
        add 1 to {_i}
    return {_out}

function fact(n: number) :: number:
    if {_n} is less than or equal to 1:
        return 1
    return ({_n} * fact(({_n} - 1)))

function doubleIt(n: number) :: number:
    return ({_n} * 2)

function sumAll(ns: numbers) :: number:
    set {_total} to 0
    loop {_ns::*}:
        add loop-value to {_total}
    return {_total}

function makeRange(n: number) :: objects:
    loop {_n} times:
        add loop-value to {_r::*}
    return {_r::*}

function announce(flag: number):
    if {_flag} is not 1:
        stop
    broadcast "announced"

function scopeProbe():
    broadcast "fn sees v=[%{_v}%]"
    set {_v} to "function"

function slowFn() :: text:
    wait 1 seconds
    broadcast "slow tail"

function ov(a: number) :: text:
    return "num:%{_a}%"

function ov(a: text) :: text:
    return "text:%{_a}%"

command /greet [<text>]:
    trigger:
        send greet(arg-1) to player

command /greetlit:
    trigger:
        send "lit=%greet("World")%" to player

command /greet2 [<text>]:
    trigger:
        send "greet2=%greetTimes(arg-1)%" to player

command /greet3 [<text>]:
    trigger:
        send "greet3=%greetTimes(arg-1, 3)%" to player

command /fact [<integer>]:
    trigger:
        send "fact=%fact(arg-1)%" to player

command /double [<integer>]:
    trigger:
        send "double=%doubleIt(arg-1)%" to player

command /badcall:
    trigger:
        set {_r} to doubleIt({mismatch})
        send "badcall=[%{_r}%]" to player

command /sumto [<integer>]:
    trigger:
        set {_r::*} to makeRange(arg-1)
        set {_s} to sumAll({_r::*})
        send "sumto=%{_s}%" to player

command /sum3:
    trigger:
        send "sum3=%sumAll(1, 2, 3)%" to player

command /scope [<text>]:
    trigger:
        set {_v} to arg-1
        scopeProbe()
        send "mine=[%{_v}%]" to player

command /announce [<integer>]:
    trigger:
        announce(arg-1)
        send "announce-done" to player

command /slow:
    trigger:
        set {_r} to slowFn()
        send "slow=[%{_r}%]" to player

command /ov [<integer>]:
    trigger:
        send "ov=%ov(arg-1)%" to player

command /ovt [<text>]:
    trigger:
        send "ov=%ov(arg-1)%" to player
